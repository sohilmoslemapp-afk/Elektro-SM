{
  "schemaVersion": 1,
  "title": "ElektroPlan SM project draft",
  "description": "Unverified draft project interchange format. Geometric lines are not electrical nets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "project",
    "pages",
    "technicalApproval"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "UNVERIFIED_SCHEMATIC_DRAFT"
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "technicalApproval": {
      "const": false
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "symbols",
          "graphicLines"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "title": {
            "type": "string",
            "maxLength": 100
          },
          "symbols": {
            "type": "array",
            "maxItems": 2000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "type",
                "x",
                "y",
                "verificationStatus"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "switch",
                    "lamp",
                    "relay",
                    "unknown"
                  ]
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "manufacturer": {
                  "type": "string",
                  "maxLength": 100
                },
                "model": {
                  "type": "string",
                  "maxLength": 100
                },
                "verificationStatus": {
                  "const": "UNVERIFIED"
                }
              }
            }
          },
          "graphicLines": {
            "type": "array",
            "maxItems": 5000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x1",
                "y1",
                "x2",
                "y2",
                "electricalConnection"
              ],
              "properties": {
                "x1": {
                  "type": "number"
                },
                "y1": {
                  "type": "number"
                },
                "x2": {
                  "type": "number"
                },
                "y2": {
                  "type": "number"
                },
                "electricalConnection": {
                  "const": false
                }
              }
            }
          }
        }
      }
    }
  }
}
